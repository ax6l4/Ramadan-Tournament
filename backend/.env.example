# انسخ هذا الملف إلى .env للتطوير المحلي
# Copy to .env for local development

# Render sets PORT automatically in production
PORT=3000
NODE_ENV=development

# Required in production (Render)
JWT_SECRET=change-this-to-a-long-random-secret

# Required on Render: Postgres External or Internal connection string
# Internal host looks like: postgres://USER:PASS@dpg-xxxxx-a/DB
# External host looks like: postgres://USER:PASS@dpg-xxxxx-a.REGION-postgres.render.com/DB
DATABASE_URL=

# Optional local SQLite path (used only when DATABASE_URL is empty)
# DATABASE_PATH=./../database/tournament.db

# Admin (optional overrides)
ADMIN_USERNAME=Abdul Rahman
ADMIN_PASSWORD=Aa91141702
JWT_EXPIRES_IN=8h
